{
  "version": "1.5.6",
  "platforms": [
    "win32-x64",
    "linux-x64"
  ],
  "scopes": [
    "GPU"
  ],
  "singleAlgorithmPerProcess": true,
  "algorithms": [
    {
      "algorithm": "quantus",
      "argument": "quantus",
      "devices": [
        "NVIDIA",
        "AMD"
      ]
    },
    {
      "algorithm": "pearlhash",
      "argument": "pearl",
      "devices": [
        "NVIDIA",
        "AMD"
      ]
    }
  ],
  "fees": {
    "kryptexPercent": 0,
    "otherPoolsPercent": 3
  },
  "notes": "GPU model/driver compatibility needs a hardware trial. Pool fees are separate. KRig supports Quantus and Pearl, not KawPow or CPU mining."
}
